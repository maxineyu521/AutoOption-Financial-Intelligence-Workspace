# Docker-specific overrides for local validation.
# Copy to `.env.docker` and adjust only if needed.
#
# Cloud Qdrant remains the default and is sourced from `.env`.

# API-first local validation path.
ROUTER_PROVIDER=openai
ANALYST_PROVIDER=openai
CHECKER_PROVIDER=openai
CRITIC_PROVIDER=openai
FINALIZER_PROVIDER=openai
INGESTION_LLM_PROVIDER=openai

# If you want the container to talk to an Ollama instance running on your host,
# keep these values. For SCC / remote Ollama, replace with that reachable host.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_PULL_MODEL=llama3:latest

# If you want Docker-managed Ollama instead of host Ollama, switch to:
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_OPENAI_BASE_URL=http://ollama:11434/v1
#
# And, if you want the graph to run against Ollama, also switch the providers:
# ROUTER_PROVIDER=ollama
# ANALYST_PROVIDER=ollama
# CHECKER_PROVIDER=ollama
# CRITIC_PROVIDER=ollama
# FINALIZER_PROVIDER=ollama

# Keep cache and runtime paths inside the container.
HF_HOME=/opt/hf-cache
XDG_CACHE_HOME=/opt/xdg-cache
TMPDIR=/tmp
