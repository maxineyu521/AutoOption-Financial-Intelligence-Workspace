# =============================================================================
# Automated Options Recommendation Bot — Environment Configuration Template
# Copy this file to ".env" and populate secrets before runtime.
# Node order: Keys/Storage → Qdrant → Router → Retrieval → Analyst
#             → Checker → Critic → Finalizer → Ollama Shared → Ingestion/RAGAS
#
# PROVIDER SWITCHES: each node has <NODE>_PROVIDER=openai|ollama.
#   • OpenAI path  — <NODE>_MODEL + <NODE>_OPENAI_* vars
#   • Ollama path  — OLLAMA_<NODE>_MODEL + OLLAMA_* shared vars
#     Ollama services only start under: docker compose --profile ollama up
# =============================================================================


# =============================================================================
# SECTION 0 — API KEYS & SHARED STORAGE
# =============================================================================

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TIMEOUT_SECONDS=60

SEC_USER_AGENT=YourName YourOrg your_email@example.com

# NewsAPI  https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# FRED API  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

DATA_LAKE_ROOT=./Data


# =============================================================================
# SECTION 1 — QDRANT (Vector Store)
# =============================================================================

QDRANT_HOST=https://your-qdrant-endpoint.example.com
QDRANT_API_KEY=your_qdrant_api_key_here


# =============================================================================
# SECTION 2 — NODE: ROUTER
# =============================================================================

ROUTER_PROVIDER=openai
ROUTER_MODEL=gpt-4o-mini
ROUTER_TEMPERATURE=0.0
ROUTER_ENABLE_MODEL_FALLBACK=1
# OpenAI path
ROUTER_OPENAI_FALLBACK_MODEL=gpt-4o-mini
ROUTER_OPENAI_TIMEOUT_SECONDS=40
# Ollama path (active when ROUTER_PROVIDER=ollama)
OLLAMA_ROUTER_MODEL=llama3:latest


# =============================================================================
# SECTION 3 — NODE: RETRIEVAL (Vector Models + Timeouts)
# =============================================================================

# --- Dense Embedding (sentence-transformers, CPU) ---
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Sparse Embedding (SPLADE / FastEmbed, CPU) ---
SPARSE_MODEL_NAME=prithivida/Splade_PP_en_v1
FASTEMBED_THREADS=4

# --- Reranker (CrossEncoder, CPU) ---
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RETRIEVER_DEVICE=cpu

# --- Retrieval Timeouts ---
GOLD_TIMEOUT=15
SILVER_TIMEOUT=12
SILVER_MAX_TICKERS=5
HE_NOVEL_TICKERS_CAP=3
TICKER_EXPLOSION_CAP=8
TICKER_EXPLOSION_KEEP=5

# --- Query Transform (OpenAI, shared with Router) ---
TRANSFORM_EXTRACTOR_MODEL=gpt-4o-mini
TRANSFORM_HYDE_MODEL=gpt-4o-mini


# =============================================================================
# SECTION 4 — NODE: ANALYST
# =============================================================================

ANALYST_PROVIDER=openai
ANALYST_MODEL=gpt-4o
ANALYST_PRIMARY_MODEL=gpt-4o
ANALYST_TEMPERATURE=0.0
ANALYST_MAX_TOKENS=500
ANALYST_TIMEOUT_SECONDS=180

# OpenAI path
ANALYST_OPENAI_TIMEOUT_SECONDS=45
ANALYST_OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Ollama path (active when ANALYST_PROVIDER=ollama + ollama Docker profile)
# ANALYST_LLM_BACKEND: legacy field, superseded by ANALYST_PROVIDER above.
ANALYST_LLM_BACKEND=ollama
OLLAMA_ANALYST_MODEL=options-expert-v1:latest
OLLAMA_ANALYST_FALLBACK_MODEL=llama3:latest

# Fallback master switch
ANALYST_ENABLE_MODEL_FALLBACK=1
# Set to 0 when ANALYST_PROVIDER=openai to suppress Ollama healthcheck warnings.
# Set to 1 only when running docker compose --profile ollama.
ANALYST_OLLAMA_FALLBACK_ENABLED=0

# Payload size caps
ANALYST_MAX_MACRO_CHARS=1600
ANALYST_MAX_SILVER_LINES=70
ANALYST_MAX_GOLD_CHARS=3200
ANALYST_MAX_PAYLOAD_CHARS=9000


# =============================================================================
# SECTION 5 — NODE: CHECKER
# =============================================================================

CHECKER_PROVIDER=openai
CHECKER_MODEL=gpt-4o-mini
CHECKER_ENABLE_MODEL_FALLBACK=1
# OpenAI path
CHECKER_OPENAI_FALLBACK_MODEL=gpt-4o-mini
CHECKER_OPENAI_TIMEOUT_SECONDS=45
# Ollama path (active when CHECKER_PROVIDER=ollama)
OLLAMA_CHECKER_MODEL=llama3:latest

# Checker audit controls
CHECKER_NUMERIC_TOLERANCE=0.02
CHECKER_TOOL_RECOVERY=1
CHECKER_MACRO_EXEMPT_ENABLED=1
CHECKER_COVERAGE_CHECK_ENABLED=1
CHECKER_ALLOW_GOLD_AS_SILVER_ALIAS=1
CHECKER_NUMERIC_REQUIRE_SILVER_CITATION=1


# =============================================================================
# SECTION 6 — NODE: CRITIC
# =============================================================================

CRITIC_PROVIDER=openai
CRITIC_MODEL=gpt-4o-mini
CRITIC_TEMPERATURE=0.0
CRITIC_ENABLE_MODEL_FALLBACK=1
# OpenAI path
CRITIC_OPENAI_FALLBACK_MODEL=gpt-4o-mini
CRITIC_OPENAI_TIMEOUT_SECONDS=45
# Ollama path (active when CRITIC_PROVIDER=ollama)
OLLAMA_CRITIC_MODEL=options-expert-v1:latest


# =============================================================================
# SECTION 7 — NODE: FINALIZER
# =============================================================================

FINALIZER_PROVIDER=openai
FINALIZER_MODEL=gpt-4o
FINALIZER_PRIMARY_MODEL=gpt-4o
FINALIZER_TEMPERATURE=0.0
FINALIZER_ENABLE_MODEL_FALLBACK=1
# OpenAI path
FINALIZER_OPENAI_FALLBACK_MODEL=gpt-4o-mini
FINALIZER_OPENAI_TIMEOUT_SECONDS=45
# Ollama path (active when FINALIZER_PROVIDER=ollama)
OLLAMA_FINALIZER_MODEL=options-expert-v1:latest

FINALIZER_LLAMA3_ENRICHMENT=0


# =============================================================================
# SECTION 8 — OLLAMA SHARED CONFIGURATION
# =============================================================================
# Services only start under: docker compose --profile ollama up

OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Must be OpenAI-compatible endpoint base (ends with /v1)
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
OLLAMA_OPENAI_API_KEY=ollama
OLLAMA_BASE_MODEL=llama3.3:70b
OLLAMA_CUSTOM_MODEL_NAME=options-expert-v1:latest
# How long Ollama keeps the model pinned in GPU after the last request
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT=600
# Ingestion-time helpers
OLLAMA_INGESTION_MODEL=llama3:latest


# =============================================================================
# SECTION 9 — INGESTION & RAGAS (Evaluation Pipeline)
# =============================================================================

INGESTION_LLM_PROVIDER=openai
OPENAI_INGESTION_MODEL=gpt-4o-mini

# RAGAS judge configuration.
# Use OpenAI for reference-aware scoring such as AnswerCorrectness.
RAGAS_JUDGE_PROVIDER=openai
RAGAS_JUDGE_MODEL=gpt-4o
RAGAS_EMBED_MODEL=text-embedding-3-small
RAGAS_OPENAI_JUDGE_MODEL=gpt-4o
RAGAS_OPENAI_EMBED_MODEL=text-embedding-3-small


# =============================================================================
# SECTION 10 — AGENT GOVERNANCE CONTROLS
# =============================================================================

AGENT_MAX_REVISIONS=3
INSIDER_SIGNAL_MIN_COUNT=3


# =============================================================================
# SECTION 11 — OPTIONAL RUNTIME AND CACHE CONTROLS
# =============================================================================

PYTHON_ENV=dev
YFINANCE_CACHE_DIR=
XDG_CACHE_HOME=
TMPDIR=
